msgctxt "model:ir.message,text:msg_certificate_metadata"
msgid ""
"Subject: %(subject)s\n"
"Issuer: %(issuer)s\n"
"Serial Number: %(serial_number)s\n"
"Valid From: %(valid_from)s\n"
"Valid Until: %(valid_until)s\n"
"SHA-256 Fingerprint: %(fingerprint)s"
msgstr ""
